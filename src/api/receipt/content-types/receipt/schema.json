{
  "kind": "collectionType",
  "collectionName": "receipts",
  "info": {
    "singularName": "receipt",
    "pluralName": "receipts",
    "displayName": "Чек",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "oofd_uid": {
      "type": "string",
      "required": false,
      "unique": true
    },
    "qrData": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "fiscalId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "verificationStatus": {
      "type": "enumeration",
      "enum": [
        "auto_verified",
        "auto_rejected",
        "manual_review",
        "manually_verified",
        "manually_rejected",
        "auto_rejected_late_submission",
        "auto_partially_verified",
        "manually_partially_verified"
      ],
      "required": true
    },
    "date": {
      "type": "datetime",
      "required": true
    },
    "totalAmount": {
      "type": "decimal",
      "required": true
    },
    "taxAmount": {
      "type": "decimal",
      "required": true
    },
    "taxRate": {
      "type": "decimal",
      "required": true
    },
    "kktCode": {
      "type": "string",
      "required": true
    },
    "kktSerialNumber": {
      "type": "string",
      "required": true
    },
    "paymentMethod": {
      "type": "string",
      "required": true
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "receipts"
    },
    "items": {
      "type": "dynamiczone",
      "components": [
        "receipt-item.product-claim",
        "receipt-item.item"
      ]
    },
    "finalCashback": {
      "type": "decimal"
    },
    "ofdType": {
      "type": "enumeration",
      "enum": [
        "oofd",
        "kofd",
        "wofd"
      ],
      "required": true
    },
    "countsForScanTask": {
      "type": "boolean",
      "default": false
    },
    "platform": {
      "type": "enumeration",
      "enum": [
        "ios",
        "android"
      ],
      "required": false
    },
    "appVersion": {
      "type": "string",
      "required": false,
      "description": "Версия мобильного приложения, с которой отправлен чек (например, 1.9.0)"
    },
    "organizationName": {
      "type": "string",
      "required": false,
      "description": "Название организации-продавца из фискальных данных чека (oofd/kofd/wofd)"
    },
    "organizationBin": {
      "type": "string",
      "required": false,
      "description": "БИН организации-продавца из фискальных данных чека (oofd/kofd/wofd)"
    },
    "organizationAddress": {
      "type": "string",
      "required": false,
      "description": "Адрес точки продажи из фискальных данных чека (доступно для oofd и wofd; в данных kofd адреса нет)"
    },
    "organizationCity": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::city.city",
      "description": "Город точки продажи, определённый из organizationAddress через deriveCityAndAddress() — НЕ город пользователя (см. User.city). Для аналитики чеков используется именно это поле."
    },
    "citySource": {
      "type": "enumeration",
      "enum": [
        "organization",
        "user",
        "unknown"
      ],
      "default": "unknown",
      "description": "Источник organizationCity: organization — определён из адреса чека; user — зарезервировано под будущий fallback на город пользователя (пока не используется); unknown — определить не удалось (нет адреса, KOFD, адрес не распознан)"
    },
    "receiptPhoto": {
      "type": "media",
      "multiple": false,
      "required": false,
      "description": "Фото чека (альтернативный способ добавления чека — QR распознаётся с этого же фото, а не сканером)"
    },
    "submissionMethod": {
      "type": "enumeration",
      "enum": [
        "photo"
      ],
      "required": false,
      "description": "Заполняется только для чеков, отправленных через фото вместо QR-скана — обычные QR-чеки это поле не заполняют (остаётся null)"
    }
  }
}
