{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Категория"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": false
    },
    "description": {
      "type": "text",
      "required": false
    },
    "sortOrder": {
      "type": "integer",
      "default": 0,
      "required": true,
      "description": "Порядок отображения внутри группы (для будущего раздела «Заказ») — меньше значит выше"
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product",
      "mappedBy": "category"
    },
    "group": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::group.group",
      "inversedBy": "categories"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "required": true
    }
  }
}
