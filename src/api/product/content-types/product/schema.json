{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Товар",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "canonicalName": {
      "type": "string",
      "required": true,
      "unique": true,
      "displayName": "Canonical name"
    },
    "barcode": {
      "type": "string",
      "required": false,
      "unique": true,
      "minLength": 13,
      "maxLength": 13,
      "regex": "^\\d{13}$",
      "displayName": "Barcode (EAN-13)"
    },
    "ntin": {
      "type": "string",
      "required": false,
      "unique": true,
      "minLength": 13,
      "maxLength": 13,
      "regex": "^\\d{13}$",
      "displayName": "NTIN"
    },
    "ntinAlternative": {
      "type": "string",
      "required": false,
      "unique": true,
      "minLength": 13,
      "maxLength": 13,
      "regex": "^\\d{13}$",
      "displayName": "NTIN (альтернативный)"
    },
    "cashbackEligible": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "productAliases": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product-alias.product-alias",
      "mappedBy": "product"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "products"
    },
    "brand": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::brand.brand",
      "inversedBy": "products"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "cashbackAmount": {
      "type": "decimal",
      "default": 0,
      "required": true
    },
    "recommendedRetailPrice": {
      "type": "decimal",
      "required": false,
      "description": "РРЦ — для сверки цены за единицу в позиции чека с рекомендованной розничной ценой товара"
    },
    "unpublishDate": {
      "type": "date"
    },
    "description": {
      "type": "text"
    },
    "article": {
      "type": "string",
      "required": false,
      "unique": true,
      "description": "Внутренний артикул PharmUp (не путать с supplierArticle на ProductSupplier — своим артикулом каждого поставщика)"
    },
    "productSuppliers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product-supplier.product-supplier",
      "mappedBy": "product"
    },
    "cashbackHistory": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product-cashback-history.product-cashback-history",
      "mappedBy": "product"
    },
    "cityOverrides": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product-city-override.product-city-override",
      "mappedBy": "product"
    },
    "cashbackSupplier": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::supplier.supplier",
      "description": "Поставщик, финансирующий кешбэк за этот товар — с его депозита списывается сумма при начислении (этап 2, ещё не реализован). НЕ то же самое, что productSuppliers (та связь про заказ/маркетплейс, никак не про деньги на кешбэк). Пусто = кешбэк по товару начисляется как раньше, без привязки к депозиту (переходный период, пока не все товары размечены) — не блокируется и не исключается из каталога."
    }
  }
}
