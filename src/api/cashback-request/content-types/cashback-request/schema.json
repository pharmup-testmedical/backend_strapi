{
  "kind": "collectionType",
  "collectionName": "cashback_requests",
  "info": {
    "singularName": "cashback-request",
    "pluralName": "cashback-requests",
    "displayName": "Вывод средств",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "verificationStatus": {
      "type": "enumeration",
      "enum": [
        "pending",
        "awaiting_payout",
        "approved",
        "rejected",
        "manual_review"
      ],
      "default": "pending",
      "required": true
    },
    "requester": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "cashbackRequests"
    },
    "amount": {
      "type": "decimal",
      "required": true
    },
    "rejectionReason": {
      "type": "text"
    },
    "payoutMethod": {
      "type": "enumeration",
      "enum": [
        "kaspi",
        "card"
      ]
    },
    "payoutDestination": {
      "type": "string",
      "description": "Номер телефона Kaspi или номер карты — куда фактически перевести средства"
    },
    "comment": {
      "type": "text",
      "description": "Комментарий пользователя к заявке на вывод"
    }
  }
}
