{
  "kind": "collectionType",
  "collectionName": "completed_tasks",
  "info": {
    "singularName": "completed-task",
    "pluralName": "completed-tasks",
    "displayName": "Выполненное задание",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "task": {
      "type": "enumeration",
      "enum": [
        "sendInvitations",
        "leaveRating",
        "scanFirstReceipts"
      ],
      "required": true
    },
    "cashback": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "details": {
      "type": "dynamiczone",
      "components": [
        "completed-tasks.priglashenie-kolleg",
        "completed-tasks.postavit-oczenku",
        "completed-tasks.otskanirujte-pervye-cheki"
      ],
      "required": true,
      "min": 1,
      "max": 1
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "completedTasks"
    }
  }
}
