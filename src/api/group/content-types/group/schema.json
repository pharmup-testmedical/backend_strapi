{
  "kind": "collectionType",
  "collectionName": "groups",
  "info": {
    "singularName": "group",
    "pluralName": "groups",
    "displayName": "Группа товаров",
    "description": "Верхний уровень каталога (например «Медицинская техника»), объединяет несколько категорий"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": false
    },
    "description": {
      "type": "text",
      "required": false
    },
    "sortOrder": {
      "type": "integer",
      "default": 0,
      "required": true,
      "description": "Порядок отображения в каталоге (для будущего раздела «Заказ») — меньше значит выше"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "categories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::category.category",
      "mappedBy": "group"
    }
  }
}
