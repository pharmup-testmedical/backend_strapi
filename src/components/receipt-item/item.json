{
  "collectionName": "components_receipt_item_items",
  "info": {
    "displayName": "Позиция для кешбэка",
    "description": "",
    "icon": "shoppingCart"
  },
  "options": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "claimedProduct": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::product.product"
    },
    "verificationStatus": {
      "type": "enumeration",
      "enum": [
        "auto_verified_canon",
        "auto_verified_alias",
        "auto_verified_ntin",
        "auto_rejected_alias",
        "manual_review",
        "manually_verified_alias",
        "manually_rejected_alias"
      ],
      "required": true
    },
    "props": {
      "type": "component",
      "repeatable": false,
      "component": "receipt-item.item-props",
      "required": true
    },
    "productAlias": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::product-alias.product-alias"
    },
    "cashback": {
      "type": "decimal",
      "required": true
    },
    "fundingSupplier": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::supplier.supplier",
      "description": "Поставщик, профинансировавший это начисление — заморожено в момент чека (копия Product.cashbackSupplier на тот момент), не живая ссылка. Смена поставщика у товара позже не переносит уже сделанные начисления задним числом. Пусто = начислено без привязки к депозиту (см. Product.cashbackSupplier)."
    }
  }
}
